# App URLs
NEXT_PUBLIC_SITE_URL=https://www.romega-solutions.com

# Contact form email provider (required in production for /api/contact)
RESEND_API_KEY=your-resend-api-key
ADMIN_EMAIL=info@romega-solutions.com

# Optional anti-spam verification.
# Only enable this after wiring a client-side recaptcha token into the contact form payload.
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_TIMEOUT_MS=5000

# Contact form security check (Cloudflare Turnstile). Ships OFF: with the mode
# off, the form asks for no token and nothing calls Cloudflare. To turn it on,
# set the two keys first, then set the mode to "on" in a second step.
# The site key is public; the secret key is server-side only. Never commit real
# values. Cloudflare's public test keys are for local runs only and are refused
# in production.
CONTACT_TURNSTILE_MODE=off
CONTACT_TURNSTILE_SITE_KEY=
CONTACT_TURNSTILE_SECRET_KEY=
# Optional. Comma-separated host names a real token may come from.
# Defaults to romega-solutions.com,www.romega-solutions.com.
# CONTACT_TURNSTILE_ALLOWED_HOSTS=

# Job application form security check (Cloudflare Turnstile). Same rules as the
# contact form above, with its own keys. Ships OFF.
APPLY_TURNSTILE_MODE=off
APPLY_TURNSTILE_SITE_KEY=
APPLY_TURNSTILE_SECRET_KEY=
# Optional. Comma-separated host names a real token may come from.
# Defaults to romega-solutions.com,www.romega-solutions.com.
# APPLY_TURNSTILE_ALLOWED_HOSTS=

# ─── Careers feed (shared with RS-Tool-Ticketing-System) ─────────────────────
# /api/careers/jobs reads open positions directly from the ticketing
# system's Supabase project (table: `positions`, where `is_open = true`).
# Use the SAME values as RS-Tool-Ticketing-System/.env.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the ticketing-system deployment. Used SERVER-SIDE only by
# /api/apply/[positionId] when forwarding submissions to the ticketing
# system's /api/public/applications/[positionId] endpoint.
TICKETING_APP_URL=https://your-ticketing-system.vercel.app

# Shared bearer token for the ticketing system's public applications
# endpoint. Must match PUBLIC_APPLICATIONS_TOKEN in
# RS-Tool-Ticketing-System/.env. Server-side only — never exposed to the
# browser. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUBLIC_APPLICATIONS_TOKEN=replace-with-random-64-char-hex-token

# Local-only dev convenience: capture form submissions without RESEND_API_KEY (set true only for dev).
EMAIL_CONTACT_FALLBACK_ENABLED=false

# ─── Chat assistant (Groq) ─────────────────────────────────────────────────────
# Used SERVER-SIDE only by /api/chat. If unset, the chat falls back to the
# built-in rule-based replies (graceful degradation).
# Get a key at https://console.groq.com/keys — never commit a real key.
GROQ_API_KEY=
# Optional override. Defaults to llama-3.3-70b-versatile.
GROQ_MODEL=llama-3.3-70b-versatile

# Microsoft Clarity project ID (public). Clarity loads only on the Production
# deployment, only with this set, and records only after a visitor accepts the
# banner. Leave empty everywhere else.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
