# App URLs
NEXT_PUBLIC_SITE_URL=https://www.romega-solutions.com

# Contact form email provider (required in production for /api/contact)
RESEND_API_KEY=your-resend-api-key
ADMIN_EMAIL=info@romega-solutions.com

# Optional anti-spam verification.
# Only enable this after wiring a client-side recaptcha token into the contact form payload.
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_TIMEOUT_MS=5000

# ─── Careers feed (shared with RS-Tool-Ticketing-System) ─────────────────────
# /api/careers/jobs reads open positions directly from the ticketing
# system's Supabase project (table: `positions`, where `is_open = true`).
# Use the SAME values as RS-Tool-Ticketing-System/.env.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the ticketing-system deployment. Used SERVER-SIDE only by
# /api/apply/[positionId] when forwarding submissions to the ticketing
# system's /api/public/applications/[positionId] endpoint.
TICKETING_APP_URL=https://your-ticketing-system.vercel.app

# Shared bearer token for the ticketing system's public applications
# endpoint. Must match PUBLIC_APPLICATIONS_TOKEN in
# RS-Tool-Ticketing-System/.env. Server-side only — never exposed to the
# browser. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUBLIC_APPLICATIONS_TOKEN=replace-with-random-64-char-hex-token

# Local-only dev convenience: capture form submissions without RESEND_API_KEY (set true only for dev).
EMAIL_CONTACT_FALLBACK_ENABLED=false
